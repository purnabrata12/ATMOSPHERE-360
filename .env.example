# For a zero-configuration demo leave DATABASE_URL unset (SQLite will be used).
# To use XAMPP: start MySQL, import database/atmosphere360.sql and uncomment:
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/atmosphere360
FLASK_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
PORT=5000
# Optional: identify your app when requesting OpenStreetMap reverse geocoding.
NOMINATIM_CONTACT=your-email@example.com
# Number of days for voluntary, consent-based IP search logs.
SEARCH_LOG_RETENTION_DAYS=30
